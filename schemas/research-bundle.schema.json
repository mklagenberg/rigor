{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mklagenberg/rigor/schemas/research-bundle.schema.json",
  "title": "RIGOR Research Bundle",
  "type": "object",
  "required": ["schema_version", "brief", "plan", "sources", "claims", "handoffs", "dossier"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "brief": {"type": "object", "required": ["question", "outcome", "level", "level_rationale", "scope", "permissions"]},
    "plan": {"type": "object", "required": ["plan_id", "workstreams", "stop_conditions"], "properties": {"plan_id": {"type": "string"}, "workstreams": {"type": "array"}, "stop_conditions": {"type": "array"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "author", "title", "source_type", "venue", "published_at", "accessed_at", "url", "status", "independence_group"]}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "claim_type", "statement", "citations", "support_status"], "properties": {"citations": {"type": "array", "items": {"type": "string"}}}}},
    "handoffs": {"type": "array", "items": {"type": "object", "required": ["handoff_id", "role", "work_performed", "claim_ids", "source_ids", "gaps", "recommended_next_action"]}},
    "dossier": {"type": "object", "required": ["dossier_id", "title", "plan_id", "claim_ids", "conclusion", "confidence_rationale", "limitations", "revalidation"]}
  }
}